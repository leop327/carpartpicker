# Google AI Studio / Gemini API key (server-side only — never commit the real key)
# https://aistudio.google.com/apikey
# Image models need quota (often billing). Without it the UI uses a local colour preview.
GEMINI_API_KEY=

# Optional override (default tries gemini-3.1-flash-image, then 2.5-flash-image, then pro)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# UK DVLA Vehicle Enquiry Service API key (server-side only)
# https://developer-portal.driver-vehicle-licensing.api.gov.uk/
# Without a key, /api/dvla returns deterministic demo matches (B58DEMO, N55DEMO, S58DEMO…).
DVLA_API_KEY=
